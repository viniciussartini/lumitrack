{
    "compilerOptions": {
        "ignoreDeprecations": "5.0", // silencia avisos de APIs obsoletas (ex: crypto.randomUUID) — "6.0" não é aceito pelo TypeScript 5.9.3 instalado (TS5103)
        /* --- Linguagem e ambiente --- */
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext", // ES Modules para Node.js moderno
        "moduleResolution": "NodeNext",

        /* --- Path aliases --- */
        "paths": {
            "@/*": ["./src/*"] // @/modules/user → src/modules/user
        },

        /* --- Output --- */
        "outDir": "dist",
        "rootDir": "src",

        /* --- Build incremental --- */
        // Sem isto, `tsc --noEmit` (usado no pre-commit e no gate de type-check)
        // não tem cache nenhum — paga type-check completo a cada chamada. O
        // .tsbuildinfo fica em node_modules/.tmp (já gitignored) para não
        // repetir o erro de tê-lo commitado na raiz do pacote.
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

        /* --- Qualidade e segurança --- */
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "exactOptionalPropertyTypes": true,

        /* --- Interoperabilidade --- */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,

        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
