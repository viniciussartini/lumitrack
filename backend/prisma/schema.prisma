// LumiTrack — Schema Prisma
// Banco de dados: PostgreSQL

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// Pessoa física (residencial) vs. pessoa jurídica (comercial/industrial)
enum UserType {
  INDIVIDUAL // Pessoa física
  COMPANY // Pessoa jurídica
}

// Tipo de instalação elétrica — impacta cálculos de consumo e custo
enum ElectricalSystemType {
  MONOPHASIC // Monofásico (1 fase)
  BIPHASIC // Bifásico (2 fases)
  TRIPHASIC // Trifásico (3 fases)
}

// Canal pelo qual o token foi emitido — mobile não expira, web expira
enum TokenChannel {
  WEB
  MOBILE
}

// RBAC mínimo (#16 — A01/Art. 48): distingue usuários comuns de
// administradores. Sempre lida do banco a cada requisição (nunca um claim do
// JWT) — ver shared/middlewares/authenticate.ts — para que promover/rebaixar
// um admin tenha efeito imediato, sem exigir novo login. Documento de design
// para um sistema de permissões mais extensível: .claude/docs/RBAC_DESIGN.md.
enum Role {
  USER
  ADMIN

  @@map("role")
}

// Eventos de segurança registrados no audit log (#08 — A09/Art. 46).
enum AuditAction {
  LOGIN
  LOGOUT
  ACCESS_DENIED
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  PROPERTY_CREATE
  PROPERTY_UPDATE
  PROPERTY_DELETE
  DATA_EXPORT
  MFA_ENABLED
  MFA_DISABLED
  REFRESH_TOKEN_REUSE_DETECTED
  ADMIN_AUDIT_LOG_VIEW

  @@map("audit_action")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

// A qual nível da hierarquia um medidor (e, por consequência, a agregação de
// consumo e os alertas) pertence. Um medidor é vinculado a exatamente um alvo.
enum TargetType {
  PROPERTY
  AREA
  DEVICE
}

// Classe de faturamento do Grupo B (baixa tensão) — REN 1.000/2021.
// B1 residencial, B2 rural, B3 demais (comércio/serviços/pequena indústria).
// Grupo A (alta/média tensão, tarifa binômia) fica para uma fase futura.
enum BillingClass {
  B1
  B2
  B3
}

// Bandeira tarifária vigente (sinal mensal de custo de geração da ANEEL).
// RED_P1/RED_P2 = vermelha patamar 1/2.
enum TariffFlag {
  GREEN
  YELLOW
  RED_P1
  RED_P2
}

enum IoTProtocol {
  MQTT
  MODBUS_TCP
  MODBUS_RTU
  ETHERNET_IP
  PROFIBUS
  PROFINET
  RS232
  RS485

  @@map("iot_protocol")
}

// ─────────────────────────────────────────────────────────────────────────────
// USUÁRIO
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // hash bcrypt
  userType  UserType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RBAC mínimo (#16 — A01/Art. 48). Ver enum Role acima.
  role Role @default(USER)

  // Consentimento LGPD (Art. 7º/8º) — registrado no cadastro.
  // consentVersion identifica qual versão da Política de Privacidade/Termos
  // foi aceita, permitindo solicitar reaceite quando o documento mudar.
  consentedAt    DateTime?
  consentVersion String?

  // Campos exclusivos de pessoa física
  firstName String?
  lastName  String?
  // cpf armazena o valor criptografado (AES-256-GCM, ver shared/crypto/encryption.ts)
  // — não pode ser @unique porque o IV aleatório faz o mesmo CPF gerar
  // ciphertext diferente a cada criptografia. cpfBlindIndex (HMAC-SHA256,
  // determinístico) é quem garante unicidade e permite busca por igualdade.
  cpf           String?
  cpfBlindIndex String? @unique

  // Campos exclusivos de pessoa jurídica
  companyName String?
  // cnpj armazena o valor criptografado — mesma lógica do cpf acima.
  cnpj           String?
  cnpjBlindIndex String? @unique
  tradeName      String?

  // MFA opcional via TOTP (#12 — A06/A07). mfaSecret armazena o segredo
  // criptografado (AES-256-GCM, chave própria — ver
  // shared/crypto/mfaEncryption.ts), nunca em texto claro. mfaEnabled
  // controla se o segundo fator é exigido no login — fica false até o
  // usuário confirmar o setup com um código válido.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // Relacionamentos
  properties     Property[]
  tokens         AuthToken[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  alerts         Alert[]
  auditLogs      AuditLog[]
  mfaBackupCodes MfaBackupCode[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTENTICAÇÃO E SEGURANÇA
// ─────────────────────────────────────────────────────────────────────────────

// Armazena tokens emitidos para permitir revogação (logout e expiração).
model AuthToken {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  channel   TokenChannel
  expiresAt DateTime? // null = mobile (não expira por tempo)
  revokedAt DateTime? // null = ainda válido
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("auth_tokens")
}

// Refresh token da sessão WEB (#14 — A06). Token opaco (randomBytes), nunca
// um JWT — só é validado via lookup no banco, nunca decodificado client-side.
// Rotacionado a cada uso: replacedByTokenId encadeia a linhagem, permitindo
// detectar reuso de um token já trocado (sinal de roubo — ver auth.service.ts).
// Existe só para o canal WEB; MOBILE já tem token de 90 dias, sem refresh.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  token             String    @unique // hash SHA-256 do valor opaco — nunca o valor puro
  expiresAt         DateTime
  revokedAt         DateTime? // null = ainda válido
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

// Códigos de backup do MFA (#12) — uso único, gerados em lote no momento do
// setup e exibidos uma única vez ao usuário (só o hash bcrypt fica
// persistido). Cobrem o caso de perda do dispositivo com o app autenticador.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // hash bcrypt — mesmo padrão usado para a senha
  usedAt    DateTime? // null = ainda não usado
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

// Trilha de auditoria (#08 — A09/Art. 46): login/logout, acesso negado (403)
// e CRUD de dados pessoais (User/Property). `userId` é nullable e usa
// `onDelete: SetNull` — diferente das outras relações com User (que usam
// Cascade) — de propósito: o registro de auditoria deve sobreviver à
// exclusão da conta (é exatamente o tipo de evento que o Art. 48 pede pra
// conseguir reconstruir depois de um incidente). `metadata` guarda contexto
// adicional sem incluir valores sensíveis (ex.: nomes de campos alterados,
// nunca os valores em si).
model AuditLog {
  id           String       @id @default(uuid())
  userId       String?
  action       AuditAction
  outcome      AuditOutcome
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([outcome])
  @@index([resourceType])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISTRIBUIDORA DE ENERGIA
// ─────────────────────────────────────────────────────────────────────────────

// Catálogo global de distribuidoras (somente leitura, populado via seed).
// Deixou de ser cadastrada por usuário: passa a ser um catálogo compartilhado
// com dados tarifários reais do Grupo B. `electricalSystem`/`workingVoltage`
// migraram para Property (são características da unidade consumidora, não da
// concessionária). O custo por kWh agora é decomposto em TUSD + TE + tributos
// (cálculo "por dentro"), aplicado pelo TariffService.
model EnergyDistributor {
  id   String @id @default(uuid())
  name String
  cnpj String @unique
  state String // UF (ex.: "SP", "SC") — define a alíquota de ICMS aplicável

  // Parcelas da tarifa sem tributos, em BRL/kWh. TUSD = uso do sistema de
  // distribuição; TE = energia. A tarifa efetiva ao consumidor é
  // (tusd + te) / (1 − (icms + pis + cofins)) + bandeira.
  tusdPerKwh Decimal @db.Decimal(10, 6)
  tePerKwh   Decimal @db.Decimal(10, 6)

  // Alíquotas nominais de tributos (formato decimal, ex.: 0.1800 = 18%).
  // ICMS varia por UF; PIS/COFINS são federais (~1,65% / ~7,6%).
  icmsRate   Decimal @db.Decimal(5, 4)
  pisRate    Decimal @db.Decimal(5, 4)
  cofinsRate Decimal @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("energy_distributors")
}

// ─────────────────────────────────────────────────────────────────────────────
// HIERARQUIA: PROPRIEDADE → ÁREA → APARELHO
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id            String   @id @default(uuid())
  userId        String
  distributorId String
  name          String
  address       String?
  city          String?
  state         String?
  zipCode       String?

  // Sistema elétrico da unidade consumidora (migrou da distribuidora): define o
  // piso de disponibilidade (30/50/100 kWh) aplicado na tarifação mensal.
  electricalSystem ElectricalSystemType

  // Classe de faturamento Grupo B (default residencial B1).
  billingClass BillingClass @default(B1)

  // CIP/COSIP municipal (contribuição de iluminação pública) em BRL — valor fixo
  // somado FORA da base de tributos. Opcional: nem todo município cobra.
  publicLightingFeeBrl Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor EnergyDistributor @relation(fields: [distributorId], references: [id])
  areas       Area[]
  meter       Meter?

  @@map("properties")
}

model Area {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  devices  Device[]
  meter    Meter?

  @@map("areas")
}

model Device {
  id         String   @id @default(uuid())
  areaId     String
  name       String
  brand      String?
  model      String?
  powerWatts Float? // potência nominal em Watts
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  area  Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  meter Meter?

  @@map("devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEDIDORES IoT E LEITURAS
// ─────────────────────────────────────────────────────────────────────────────

// Medidor IoT vinculado a exatamente um alvo (Property, Area ou Device).
// Exatamente um dos FKs propertyId/areaId/deviceId estará preenchido, coerente
// com targetType. O `@unique` em cada FK garante no máximo 1 medidor por alvo.
// A config de conexão migrou do antigo IoTDeviceConfig (que era 1:1 com Device).
// Posse é resolvida via alvo → Property → User (não há userId direto aqui).
model Meter {
  id         String     @id @default(uuid())
  name       String
  targetType TargetType
  propertyId String?    @unique
  areaId     String?    @unique
  deviceId   String?    @unique

  // Configuração de conexão do protocolo IoT.
  protocol IoTProtocol
  host     String?
  port     Int?
  topic    String? // para MQTT
  address  String? // para Modbus/RS485
  extra    Json? // configurações extras específicas do protocolo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings MeterReading[]
  alerts   Alert[]

  @@map("meters")
}

// Uma linha por medidor por minuto. `minuteStart` é o instante truncado ao
// minuto (UTC, timestamp de recebimento no backend). As médias são ponderadas
// por tempo; `secondsCovered` permite um merge idempotente no upsert quando o
// rollup roda mais de uma vez no mesmo minuto (ex.: restart do servidor).
model MeterReading {
  id             String   @id @default(uuid())
  meterId        String
  minuteStart    DateTime
  kwhConsumed    Float
  avgVoltage     Float
  avgCurrent     Float
  avgPowerW      Float
  avgPowerFactor Float
  sampleCount    Int
  secondsCovered Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, minuteStart])
  @@map("meter_readings")
}

// Configuração singleton (id fixo = 1) da bandeira tarifária vigente e dos
// valores de acréscimo por 100 kWh de cada bandeira (R$/100 kWh).
model TariffFlagConfig {
  id              Int        @id @default(1)
  currentFlag     TariffFlag @default(GREEN)
  greenPer100Kwh  Decimal    @db.Decimal(10, 4)
  yellowPer100Kwh Decimal    @db.Decimal(10, 4)
  redP1Per100Kwh  Decimal    @db.Decimal(10, 4)
  redP2Per100Kwh  Decimal    @db.Decimal(10, 4)
  updatedAt       DateTime   @updatedAt

  @@map("tariff_flag_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// ALERTAS POR FAIXA DE POTÊNCIA
// ─────────────────────────────────────────────────────────────────────────────

// Alerta por faixa de potência ativa de um medidor: dispara quando a potência
// sai da faixa [ref × (1 − tol%), ref × (1 + tol%)]. Avaliado amostra a amostra
// pelo AlertEvaluator; cada episódio de disparo vira um AlertTriggerEvent.
model Alert {
  id               String  @id @default(uuid())
  userId           String
  meterId          String
  name             String
  referencePowerKw Float // potência de referência em kW
  tolerancePercent Float // tolerância em % (ex.: 2 → faixa de ±2%)
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter  Meter               @relation(fields: [meterId], references: [id], onDelete: Cascade)
  events AlertTriggerEvent[]

  @@index([meterId])
  @@map("alerts")
}

// Histórico de episódios de disparo de um alerta. Persistido no FIM do episódio
// (quando a potência normaliza, ou o alerta é desabilitado/excluído durante o
// disparo), com a duração e as estatísticas de potência do período.
model AlertTriggerEvent {
  id              String   @id @default(uuid())
  alertId         String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  minPowerW       Float
  maxPowerW       Float
  avgPowerW       Float
  sampleCount     Int
  createdAt       DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, startedAt])
  @@map("alert_trigger_events")
}
