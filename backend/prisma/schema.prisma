// LumiTrack — Schema Prisma
// Banco de dados: PostgreSQL

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// Pessoa física (residencial) vs. pessoa jurídica (comercial/industrial)
enum UserType {
  INDIVIDUAL // Pessoa física
  COMPANY // Pessoa jurídica
}

// Tipo de instalação elétrica — impacta cálculos de consumo e custo
enum ElectricalSystemType {
  MONOPHASIC // Monofásico (1 fase)
  BIPHASIC // Bifásico (2 fases)
  TRIPHASIC // Trifásico (3 fases)
}

// Canal pelo qual o token foi emitido — mobile não expira, web expira
enum TokenChannel {
  WEB
  MOBILE
}

// Eventos de segurança registrados no audit log (#08 — A09/Art. 46).
enum AuditAction {
  LOGIN
  LOGOUT
  ACCESS_DENIED
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  PROPERTY_CREATE
  PROPERTY_UPDATE
  PROPERTY_DELETE
  DATA_EXPORT
  MFA_ENABLED
  MFA_DISABLED

  @@map("audit_action")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

// Granularidade das entradas de histórico de consumo
enum ConsumptionPeriod {
  HOURLY
  DAILY
  MONTHLY
  ANNUAL
}

// A qual nível da hierarquia o alerta pertence
enum AlertTargetType {
  PROPERTY
  AREA
  DEVICE
}

enum IoTProtocol {
  MQTT
  MODBUS_TCP
  MODBUS_RTU
  ETHERNET_IP
  PROFIBUS
  PROFINET
  RS232
  RS485

  @@map("iot_protocol")
}

// ─────────────────────────────────────────────────────────────────────────────
// USUÁRIO
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // hash bcrypt
  userType  UserType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Consentimento LGPD (Art. 7º/8º) — registrado no cadastro.
  // consentVersion identifica qual versão da Política de Privacidade/Termos
  // foi aceita, permitindo solicitar reaceite quando o documento mudar.
  consentedAt    DateTime?
  consentVersion String?

  // Campos exclusivos de pessoa física
  firstName String?
  lastName  String?
  // cpf armazena o valor criptografado (AES-256-GCM, ver shared/crypto/encryption.ts)
  // — não pode ser @unique porque o IV aleatório faz o mesmo CPF gerar
  // ciphertext diferente a cada criptografia. cpfBlindIndex (HMAC-SHA256,
  // determinístico) é quem garante unicidade e permite busca por igualdade.
  cpf           String?
  cpfBlindIndex String? @unique

  // Campos exclusivos de pessoa jurídica
  companyName String?
  // cnpj armazena o valor criptografado — mesma lógica do cpf acima.
  cnpj           String?
  cnpjBlindIndex String? @unique
  tradeName      String?

  // MFA opcional via TOTP (#12 — A06/A07). mfaSecret armazena o segredo
  // criptografado (AES-256-GCM, chave própria — ver
  // shared/crypto/mfaEncryption.ts), nunca em texto claro. mfaEnabled
  // controla se o segundo fator é exigido no login — fica false até o
  // usuário confirmar o setup com um código válido.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // Relacionamentos
  properties     Property[]
  distributors   EnergyDistributor[]
  tokens         AuthToken[]
  passwordResets PasswordReset[]
  alerts         Alert[]
  auditLogs      AuditLog[]
  mfaBackupCodes MfaBackupCode[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTENTICAÇÃO E SEGURANÇA
// ─────────────────────────────────────────────────────────────────────────────

// Armazena tokens emitidos para permitir revogação (logout e expiração).
model AuthToken {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  channel   TokenChannel
  expiresAt DateTime? // null = mobile (não expira por tempo)
  revokedAt DateTime? // null = ainda válido
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("auth_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

// Códigos de backup do MFA (#12) — uso único, gerados em lote no momento do
// setup e exibidos uma única vez ao usuário (só o hash bcrypt fica
// persistido). Cobrem o caso de perda do dispositivo com o app autenticador.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // hash bcrypt — mesmo padrão usado para a senha
  usedAt    DateTime? // null = ainda não usado
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

// Trilha de auditoria (#08 — A09/Art. 46): login/logout, acesso negado (403)
// e CRUD de dados pessoais (User/Property). `userId` é nullable e usa
// `onDelete: SetNull` — diferente das outras relações com User (que usam
// Cascade) — de propósito: o registro de auditoria deve sobreviver à
// exclusão da conta (é exatamente o tipo de evento que o Art. 48 pede pra
// conseguir reconstruir depois de um incidente). `metadata` guarda contexto
// adicional sem incluir valores sensíveis (ex.: nomes de campos alterados,
// nunca os valores em si).
model AuditLog {
  id           String       @id @default(uuid())
  userId       String?
  action       AuditAction
  outcome      AuditOutcome
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISTRIBUIDORA DE ENERGIA
// ─────────────────────────────────────────────────────────────────────────────

model EnergyDistributor {
  id               String               @id @default(uuid())
  userId           String
  name             String
  cnpj             String
  electricalSystem ElectricalSystemType
  workingVoltage   Float // em Volts (ex.: 127, 220, 380)
  kwhPrice          Decimal  @db.Decimal(10, 6) // preço por kWh em BRL (ex: 0.750000)
  taxRate           Decimal? @db.Decimal(5, 4) // @db.Decimal(5,4): alíquotas em formato decimal (ex: 0.1200 = 12%)
  publicLightingFee Decimal? @db.Decimal(10, 2) // @db.Decimal(10,2): valor monetário em BRL (ex: 45.90)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]

  // O mesmo CNPJ pode ser cadastrado por usuários diferentes (uma distribuidora
  // pode ter contratos com vários usuários), mas um usuário não pode cadastrar
  // a mesma distribuidora duas vezes.
  @@unique([userId, cnpj])
  @@map("energy_distributors")
}

// ─────────────────────────────────────────────────────────────────────────────
// HIERARQUIA: PROPRIEDADE → ÁREA → APARELHO
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id            String   @id @default(uuid())
  userId        String
  distributorId String
  name          String
  address       String?
  city          String?
  state         String?
  zipCode       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor EnergyDistributor   @relation(fields: [distributorId], references: [id])
  areas       Area[]
  consumption ConsumptionRecord[]
  alerts      Alert[]

  @@map("properties")
}

model Area {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  devices     Device[]
  consumption ConsumptionRecord[]
  alerts      Alert[]

  @@map("areas")
}

model Device {
  id         String   @id @default(uuid())
  areaId     String
  name       String
  brand      String?
  model      String?
  powerWatts Float? // potência nominal em Watts
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  area        Area                @relation(fields: [areaId], references: [id], onDelete: Cascade)
  consumption ConsumptionRecord[]
  alerts      Alert[]
  iotConfig   IoTDeviceConfig?

  @@map("devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// HISTÓRICO DE CONSUMO
// ─────────────────────────────────────────────────────────────────────────────

// Registro polimórfico: pode pertencer a Property, Area ou Device.
// Apenas um dos FKs estará preenchido por registro.
model ConsumptionRecord {
  id            String            @id @default(uuid())
  propertyId    String?
  areaId        String?
  deviceId      String?
  period        ConsumptionPeriod
  referenceDate DateTime // data de início do período medido
  kwhConsumed   Float // consumo em kWh
  costBrl       Float? // custo calculado em BRL
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([propertyId, period, referenceDate])
  @@index([areaId, period, referenceDate])
  @@index([deviceId, period, referenceDate])
  @@map("consumption_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// ALERTAS E NOTIFICAÇÕES
// ─────────────────────────────────────────────────────────────────────────────

model Alert {
  id           String          @id @default(uuid())
  userId       String
  targetType   AlertTargetType
  propertyId   String?
  areaId       String?
  deviceId     String?
  thresholdKwh Float // gatilho: consumo acima deste valor dispara o alerta
  message      String?
  triggeredAt  DateTime? // quando foi disparado (null = ainda não disparado)
  readAt       DateTime? // quando o usuário visualizou
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// IoT / PROTOCOLOS
// ─────────────────────────────────────────────────────────────────────────────

model IoTDeviceConfig {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  protocol  IoTProtocol // MQTT, Modbus, EtherNet/IP, Profibus, RS485, etc.
  host      String?
  port      Int?
  topic     String? // para MQTT
  address   String? // para Modbus/RS485
  extra     Json? // configurações extras específicas do protocolo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("iot_device_configs")
}
