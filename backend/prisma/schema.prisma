// LumiTrack — Schema Prisma
// Banco de dados: PostgreSQL

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// Pessoa física (residencial) vs. pessoa jurídica (comercial/industrial)
enum UserType {
  INDIVIDUAL // Pessoa física
  COMPANY // Pessoa jurídica
}

// Tipo de instalação elétrica — impacta cálculos de consumo e custo
enum ElectricalSystemType {
  MONOPHASIC // Monofásico (1 fase)
  BIPHASIC // Bifásico (2 fases)
  TRIPHASIC // Trifásico (3 fases)
}

// Canal pelo qual o token foi emitido — mobile não expira, web expira
enum TokenChannel {
  WEB
  MOBILE
}

// RBAC mínimo (A01/Art. 48): distingue usuários comuns de
// administradores. Sempre lida do banco a cada requisição (nunca um claim do
// JWT) — ver shared/middlewares/authenticate.ts — para que promover/rebaixar
// um admin tenha efeito imediato, sem exigir novo login. Documento de design
// para um sistema de permissões mais extensível: .claude/docs/RBAC_DESIGN.md.
enum Role {
  USER
  ADMIN

  @@map("role")
}

// Eventos de segurança registrados no audit log (A09/Art. 46).
enum AuditAction {
  LOGIN
  LOGOUT
  ACCESS_DENIED
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  PROPERTY_CREATE
  PROPERTY_UPDATE
  PROPERTY_DELETE
  DATA_EXPORT
  MFA_ENABLED
  MFA_DISABLED
  REFRESH_TOKEN_REUSE_DETECTED
  ADMIN_AUDIT_LOG_VIEW

  @@map("audit_action")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

// A qual nível da hierarquia um medidor (e, por consequência, a agregação de
// consumo e os alertas) pertence. Um medidor é vinculado a exatamente um alvo.
enum TargetType {
  PROPERTY
  AREA
  DEVICE
}

// Classe de faturamento do Grupo B (baixa tensão) — REN 1.000/2021.
// B1 residencial, B2 rural, B3 demais (comércio/serviços/pequena indústria).
// Exclusivo do Grupo B — Grupo A usa TariffSubgroup (ver abaixo), definido por
// tensão de fornecimento, não por classe de uso (ADR-0019 separa os dois
// conceitos que este enum conflacionava antes da Fase 19).
enum BillingClass {
  B1
  B2
  B3
}

// Grupo tarifário — definido pela tensão de fornecimento (ADR-0019).
// Property.tariffGroup é o campo que o TariffService ramifica por ele
// (monômio Grupo B × binômio Grupo A).
enum TariffGroup {
  GROUP_A
  GROUP_B

  @@map("tariff_group")
}

// Subgrupo do Grupo A (alta/média tensão) — REN 1.000/2021. B1/B2/B3
// (Grupo B) continuam em BillingClass; unificar os dois não tem consumidor
// real hoje (ADR-0019).
enum TariffSubgroup {
  A1
  A2
  A3
  A3A
  A4
  AS

  @@map("tariff_subgroup")
}

// Modalidade tarifária do Grupo A. Verde é a única implementada na Fase 19
// (fatiamento por modalidade); Azul chega na Fase 20; Convencional Binômia
// está em extinção gradual (avaliada na Fase 20). As 3 já são vocabulário
// fixado em 02-requisitos.md — não é especulação incluir o enum completo.
enum TariffModality {
  CONVENTIONAL_BINOMIAL
  GREEN
  BLUE

  @@map("tariff_modality")
}

// Posto tarifário horário. INTERMEDIATE é exclusivo da Tarifa Branca
// (Grupo B, Fase 22) — Verde/Azul do Grupo A só usam ponta e fora de ponta;
// adicionar o valor então é migração aditiva trivial (ADR-0019).
enum TariffPost {
  PEAK
  OFF_PEAK

  @@map("tariff_post")
}

// Bandeira tarifária vigente (sinal mensal de custo de geração da ANEEL).
// RED_P1/RED_P2 = vermelha patamar 1/2.
enum TariffFlag {
  GREEN
  YELLOW
  RED_P1
  RED_P2
}

enum IoTProtocol {
  MQTT
  MODBUS_TCP
  MODBUS_RTU
  ETHERNET_IP
  PROFIBUS
  PROFINET
  RS232
  RS485

  @@map("iot_protocol")
}

// ─────────────────────────────────────────────────────────────────────────────
// USUÁRIO
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // hash bcrypt
  userType  UserType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RBAC mínimo (A01/Art. 48). Ver enum Role acima.
  role Role @default(USER)

  // Consentimento LGPD (Art. 7º/8º) — registrado no cadastro.
  // consentVersion identifica qual versão da Política de Privacidade/Termos
  // foi aceita, permitindo solicitar reaceite quando o documento mudar.
  consentedAt    DateTime?
  consentVersion String?

  // Campos exclusivos de pessoa física
  firstName     String?
  lastName      String?
  // cpf armazena o valor criptografado (AES-256-GCM, ver shared/crypto/encryption.ts)
  // — não pode ser @unique porque o IV aleatório faz o mesmo CPF gerar
  // ciphertext diferente a cada criptografia. cpfBlindIndex (HMAC-SHA256,
  // determinístico) é quem garante unicidade e permite busca por igualdade.
  cpf           String?
  cpfBlindIndex String? @unique

  // Campos exclusivos de pessoa jurídica
  companyName    String?
  // cnpj armazena o valor criptografado — mesma lógica do cpf acima.
  cnpj           String?
  cnpjBlindIndex String? @unique
  tradeName      String?

  // MFA opcional via TOTP (A06/A07). mfaSecret armazena o segredo
  // criptografado (AES-256-GCM, chave própria — ver
  // shared/crypto/mfaEncryption.ts), nunca em texto claro. mfaEnabled
  // controla se o segundo fator é exigido no login — fica false até o
  // usuário confirmar o setup com um código válido.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // Relacionamentos
  properties        Property[]
  tokens            AuthToken[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  emailChanges      EmailChange[]
  alerts            Alert[]
  auditLogs         AuditLog[]
  mfaBackupCodes    MfaBackupCode[]
  tariffFlagChanges TariffFlagHistory[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTENTICAÇÃO E SEGURANÇA
// ─────────────────────────────────────────────────────────────────────────────

// Armazena tokens emitidos para permitir revogação (logout e expiração).
model AuthToken {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  channel   TokenChannel
  expiresAt DateTime? // null = mobile (não expira por tempo)
  revokedAt DateTime? // null = ainda válido
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

// Refresh token da sessão WEB (A06). Token opaco (randomBytes), nunca
// um JWT — só é validado via lookup no banco, nunca decodificado client-side.
// Rotacionado a cada uso: replacedByTokenId encadeia a linhagem, permitindo
// detectar reuso de um token já trocado (sinal de roubo — ver auth.service.ts).
// Existe só para o canal WEB; MOBILE já tem token de 90 dias, sem refresh.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  token             String    @unique // hash SHA-256 do valor opaco — nunca o valor puro
  expiresAt         DateTime
  revokedAt         DateTime? // null = ainda válido
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique // hash SHA-256 do valor opaco — nunca o valor puro
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// Troca de e-mail com verificação (A07): o e-mail só é efetivado
// quando o link enviado a `newEmail` é confirmado — mesmo padrão de token
// hasheado + TTL curto de PasswordReset, com a coluna extra `newEmail`
// (o alvo pendente da troca, não persistido em `User.email` até a
// confirmação).
model EmailChange {
  id        String    @id @default(uuid())
  userId    String
  newEmail  String
  token     String    @unique // hash SHA-256 do valor opaco — nunca o valor puro
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_changes")
}

// Códigos de backup do MFA — uso único, gerados em lote no momento do
// setup e exibidos uma única vez ao usuário (só o hash bcrypt fica
// persistido). Cobrem o caso de perda do dispositivo com o app autenticador.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String // hash bcrypt — mesmo padrão usado para a senha
  usedAt    DateTime? // null = ainda não usado
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Suporte ao expurgo por retenção, que filtra só por usedAt (não userId) —
  // ver AuthRepository.deleteUsedMfaBackupCodes.
  @@index([usedAt])
  @@map("mfa_backup_codes")
}

// Trilha de auditoria (A09/Art. 46): login/logout, acesso negado (403)
// e CRUD de dados pessoais (User/Property). `userId` é nullable e usa
// `onDelete: SetNull` — diferente das outras relações com User (que usam
// Cascade) — de propósito: o registro de auditoria deve sobreviver à
// exclusão da conta (é exatamente o tipo de evento que o Art. 48 pede pra
// conseguir reconstruir depois de um incidente). `metadata` guarda contexto
// adicional sem incluir valores sensíveis (ex.: nomes de campos alterados,
// nunca os valores em si).
model AuditLog {
  id           String       @id @default(uuid())
  userId       String?
  action       AuditAction
  outcome      AuditOutcome
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([outcome])
  @@index([resourceType])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISTRIBUIDORA DE ENERGIA
// ─────────────────────────────────────────────────────────────────────────────

// Catálogo global de distribuidoras (somente leitura, populado via seed).
// Deixou de ser cadastrada por usuário: passa a ser um catálogo compartilhado
// com dados tarifários reais do Grupo B. `electricalSystem`/`workingVoltage`
// migraram para Property (são características da unidade consumidora, não da
// concessionária). O custo por kWh agora é decomposto em TUSD + TE + tributos
// (cálculo "por dentro"), aplicado pelo TariffService.
model EnergyDistributor {
  id    String @id @default(uuid())
  name  String
  cnpj  String @unique
  state String // UF (ex.: "SP", "SC") — define a alíquota de ICMS aplicável

  // Parcelas da tarifa sem tributos, em BRL/kWh. TUSD = uso do sistema de
  // distribuição; TE = energia. A tarifa efetiva ao consumidor é
  // (tusd + te) / (1 − (icms + pis + cofins)) + bandeira.
  tusdPerKwh Decimal @db.Decimal(10, 6)
  tePerKwh   Decimal @db.Decimal(10, 6)

  // Alíquotas nominais de tributos (formato decimal, ex.: 0.1800 = 18%).
  // ICMS varia por UF; PIS/COFINS são federais (~1,65% / ~7,6%).
  icmsRate   Decimal @db.Decimal(5, 4)
  pisRate    Decimal @db.Decimal(5, 4)
  cofinsRate Decimal @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties        Property[]
  energyRates       TariffEnergyRate[]
  demandRates       TariffDemandRate[]

  @@map("energy_distributors")
}

// Catálogo de tarifa de ENERGIA do Grupo A, por distribuidora × subgrupo ×
// modalidade × posto (RF26) — sempre por posto, ao contrário da demanda
// (ver TariffDemandRate). tusdPerKwh/tePerKwh somados formam a tarifa de
// energia do posto (RN17), mesmo padrão de decomposição de EnergyDistributor.
model TariffEnergyRate {
  id            String         @id @default(uuid())
  distributorId String
  subgroup      TariffSubgroup
  modality      TariffModality
  post          TariffPost

  tusdPerKwh Decimal @db.Decimal(10, 6)
  tePerKwh   Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor EnergyDistributor @relation(fields: [distributorId], references: [id])

  @@unique([distributorId, subgroup, modality, post])
  @@map("tariff_energy_rates")
}

// Catálogo de tarifa de DEMANDA do Grupo A (RF26). `post` nulo representa
// demanda única (Horária Verde, RN18); Azul (Fase 20) popula PEAK/OFF_PEAK
// sem exigir migração nova — a coluna já comporta as duas formas.
// Nota 1: o Postgres trata cada NULL como distinto em índice único, então o
// `@@unique` abaixo não impede duas linhas com post nulo para a mesma
// distribuidora/subgrupo/modalidade. Sem risco hoje — o único gravador é o
// seed idempotente; reforçar em banco só se um caminho de escrita além do
// seed existir (RF45, catálogo editável, ainda sem fase).
// Nota 2: por causa da Nota 1, o Prisma **recusa em runtime** usar `post:
// null` numa cláusula where de chave composta (`upsert`/`findUnique` via
// `distributorId_subgroup_modality_post`) — "Argument `post` must not be
// null". Gravar/ler a linha de demanda única da Verde exige `findFirst` +
// create/update manual (ver `seedGroupATariffCatalog` em `prisma/seed.ts`),
// não `upsert`. O `@@unique` continua útil para as linhas com post
// preenchido (Azul, Fase 20).
model TariffDemandRate {
  id            String          @id @default(uuid())
  distributorId String
  subgroup      TariffSubgroup
  modality      TariffModality
  post          TariffPost?

  tusdPerKw Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor EnergyDistributor @relation(fields: [distributorId], references: [id])

  @@unique([distributorId, subgroup, modality, post])
  @@map("tariff_demand_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// HIERARQUIA: PROPRIEDADE → ÁREA → APARELHO
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id            String  @id @default(uuid())
  userId        String
  distributorId String
  name          String
  address       String?
  city          String?
  state         String?
  zipCode       String?

  // Sistema elétrico da unidade consumidora (migrou da distribuidora): define o
  // piso de disponibilidade (30/50/100 kWh) aplicado na tarifação mensal.
  electricalSystem ElectricalSystemType

  // Grupo tarifário (ADR-0019) — Property.tariffGroup é o discriminador
  // explícito que o TariffService ramifica por ele. Default GROUP_B preserva
  // todas as propriedades existentes sem migração de dado.
  tariffGroup TariffGroup @default(GROUP_B)

  // Classe de faturamento Grupo B (default residencial B1). Opcional porque
  // uma propriedade Grupo A não tem B1/B2/B3 — obrigatório/proibido conforme
  // tariffGroup é validado em property.schema.ts, não aqui (mesmo padrão de
  // RN01 do Medidor: regra cruzada fica no service/schema).
  billingClass BillingClass? @default(B1)

  // Subgrupo e modalidade do Grupo A (RF25) — nulos para Grupo B.
  // contractedDemandKw (demanda contratada) não mora aqui: é consumida pelo
  // cálculo binômio, então entra junto dele (Fase 19, item "Tarifação
  // binômia Horária Verde").
  tariffSubgroup TariffSubgroup?
  tariffModality TariffModality?

  // CIP/COSIP municipal (contribuição de iluminação pública) em BRL — valor fixo
  // somado FORA da base de tributos. Opcional: nem todo município cobra.
  publicLightingFeeBrl Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor EnergyDistributor @relation(fields: [distributorId], references: [id])
  areas       Area[]
  meter       Meter?

  // O Prisma Migrate cria a constraint de FK, mas não o índice no Postgres
  // (diferente do MySQL) — sem isto, toda travessia de posse (User→Property)
  // e o filtro por distribuidora fazem seq scan.
  @@index([userId])
  @@index([distributorId])
  @@map("properties")
}

model Area {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  devices  Device[]
  meter    Meter?

  @@index([propertyId])
  @@map("areas")
}

model Device {
  id         String   @id @default(uuid())
  areaId     String
  name       String
  brand      String?
  model      String?
  powerWatts Float? // potência nominal em Watts
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  area  Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  meter Meter?

  @@index([areaId])
  @@map("devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEDIDORES IoT E LEITURAS
// ─────────────────────────────────────────────────────────────────────────────

// Medidor IoT vinculado a exatamente um alvo (Property, Area ou Device).
// Exatamente um dos FKs propertyId/areaId/deviceId estará preenchido, coerente
// com targetType. O `@unique` em cada FK garante no máximo 1 medidor por alvo.
// A config de conexão migrou do antigo IoTDeviceConfig (que era 1:1 com Device).
// Posse é resolvida via alvo → Property → User (não há userId direto aqui).
model Meter {
  id         String     @id @default(uuid())
  name       String
  targetType TargetType
  propertyId String?    @unique
  areaId     String?    @unique
  deviceId   String?    @unique

  // Configuração de conexão do protocolo IoT.
  protocol IoTProtocol
  host     String?
  port     Int?
  topic    String? // para MQTT
  address  String? // para Modbus/RS485
  extra    Json? // configurações extras específicas do protocolo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  area     Area?          @relation(fields: [areaId], references: [id], onDelete: Cascade)
  device   Device?        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings MeterReading[]
  alerts   Alert[]

  @@map("meters")
}

// Uma linha por medidor por minuto. `minuteStart` é o instante truncado ao
// minuto (UTC, timestamp de recebimento no backend). As médias são ponderadas
// por tempo; `secondsCovered` permite um merge idempotente no upsert quando o
// rollup roda mais de uma vez no mesmo minuto (ex.: restart do servidor).
model MeterReading {
  id             String   @id @default(uuid())
  meterId        String
  minuteStart    DateTime
  kwhConsumed    Float
  avgVoltage     Float
  avgCurrent     Float
  avgPowerW      Float
  avgPowerFactor Float
  sampleCount    Int
  secondsCovered Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, minuteStart])
  // Índice isolado de suporte ao expurgo por retenção — o expurgo filtra só
  // por minuteStart (`< threshold`), sem meterId; o índice único acima tem
  // meterId como coluna mais à esquerda, então não serve para essa
  // varredura por regra de prefixo esquerdo.
  @@index([minuteStart])
  @@map("meter_readings")
}

// Configuração singleton (id fixo = 1) da bandeira tarifária vigente e dos
// valores de acréscimo por 100 kWh de cada bandeira (R$/100 kWh).
model TariffFlagConfig {
  id              Int        @id @default(1)
  currentFlag     TariffFlag @default(GREEN)
  greenPer100Kwh  Decimal    @db.Decimal(10, 4)
  yellowPer100Kwh Decimal    @db.Decimal(10, 4)
  redP1Per100Kwh  Decimal    @db.Decimal(10, 4)
  redP2Per100Kwh  Decimal    @db.Decimal(10, 4)
  updatedAt       DateTime   @updatedAt

  @@map("tariff_flag_config")
}

// Origem de uma troca da bandeira/valores vigentes.
enum TariffFlagChangeSource {
  MANUAL
  AUTO

  @@map("tariff_flag_change_source")
}

// Histórico de cada troca da bandeira ou dos valores vigentes —
// sincronização automática a partir da fonte oficial ANEEL, ver ADR-0007.
// Cada linha é um snapshot completo do config antes/depois
// (não só o campo que mudou), para nunca ficar ambíguo sobre o que
// estava vigente no momento da troca. changedByUserId é nulo quando
// source = AUTO (a sincronização automática não tem usuário agindo).
model TariffFlagHistory {
  id              String                 @id @default(uuid())
  previousFlag    TariffFlag?
  newFlag         TariffFlag
  previousValues  Json?
  newValues       Json
  source          TariffFlagChangeSource
  changedByUserId String?
  createdAt       DateTime               @default(now())

  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("tariff_flag_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// ALERTAS POR FAIXA DE POTÊNCIA
// ─────────────────────────────────────────────────────────────────────────────

// Alerta por faixa de potência ativa de um medidor: dispara quando a potência
// sai da faixa [ref × (1 − tol%), ref × (1 + tol%)]. Avaliado amostra a amostra
// pelo AlertEvaluator; cada episódio de disparo vira um AlertTriggerEvent.
model Alert {
  id               String  @id @default(uuid())
  userId           String
  meterId          String
  name             String
  referencePowerKw Float // potência de referência em kW
  tolerancePercent Float // tolerância em % (ex.: 2 → faixa de ±2%)
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter  Meter               @relation(fields: [meterId], references: [id], onDelete: Cascade)
  events AlertTriggerEvent[]

  @@index([meterId])
  @@index([userId])
  @@map("alerts")
}

// Histórico de episódios de disparo de um alerta. Persistido no FIM do episódio
// (quando a potência normaliza, ou o alerta é desabilitado/excluído durante o
// disparo), com a duração e as estatísticas de potência do período.
model AlertTriggerEvent {
  id              String   @id @default(uuid())
  alertId         String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  minPowerW       Float
  maxPowerW       Float
  avgPowerW       Float
  sampleCount     Int
  createdAt       DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, startedAt])
  // Suporte ao expurgo por retenção, que filtra só por createdAt (sem
  // alertId) — o índice acima tem alertId como coluna líder e não serve
  // essa varredura, mesma regra de prefixo esquerdo do índice único de
  // MeterReading.
  @@index([createdAt])
  @@map("alert_trigger_events")
}
