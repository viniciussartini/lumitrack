# LumiTrack — Backend (.env.example)
# Copie para .env e ajuste os valores. Este arquivo é versionado e NUNCA
# deve conter segredos reais — apenas placeholders.

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ─── Banco de dados (PostgreSQL) ─────────────────────────────────────────────
# Três bancos separados: app/dev, testes de service/unidade e testes de
# rotas HTTP (veja shared/test/prisma-test.ts e prisma-http-test.ts).
# ATENÇÃO: a suíte de testes APAGA os dados dos bancos de teste a cada
# execução — nunca aponte essas variáveis para um banco com dados reais.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lumitrack_dev?schema=public"
DATABASE_TEST_URL="postgresql://usuario:senha@localhost:5432/lumitrack_test?schema=public"
DATABASE_HTTP_TEST_URL="postgresql://usuario:senha@localhost:5432/lumitrack_test_http?schema=public"

# ─── Autenticação (JWT) ──────────────────────────────────────────────────────
# Gere um segredo aleatório (>= 32 caracteres), nunca reutilize este exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
JWT_WEB_EXPIRES_IN=15m
MOBILE_TOKEN_EXPIRES_IN=90d

# ─── Sessão via cookie (canal WEB) — ver #06 da remediação OWASP/LGPD ────────
# Cookie httpOnly com o JWT (sessão) + cookie legível com o token CSRF
# (double-submit). Nomes só precisam ser únicos no domínio da app — os
# defaults abaixo já funcionam sem alteração.
AUTH_COOKIE_NAME=lumitrack_session
CSRF_COOKIE_NAME=lumitrack_csrf
CSRF_HEADER_NAME=x-csrf-token

# ─── Criptografia de CPF/CNPJ (#07 da remediação OWASP/LGPD) ────────────────
# Duas chaves de 32 bytes (64 caracteres hex) — NUNCA reutilize a mesma chave
# para as duas variáveis (cifra e MAC exigem chaves independentes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_CNPJ_ENCRYPTION_KEY="troque-por-64-caracteres-hex-gerados-aleatoriamente-0000000000"
CPF_CNPJ_BLIND_INDEX_KEY="troque-por-outros-64-caracteres-hex-gerados-aleatoriamente-0000"

# ─── E-mail (SMTP) — recuperação de senha ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM="LumiTrack <no-reply@lumitrack.local>"

# ─── CORS / Frontend ─────────────────────────────────────────────────────────
# NUNCA use "*" em produção (combinado com credentials: true na API,
# exporia a aplicação a qualquer origem — bloqueado por validação em
# config/env.ts quando NODE_ENV=production).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Rate limiting (opcional — há defaults no código) ────────────────────────
# Janela em milissegundos (900000 = 15 min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
