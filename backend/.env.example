# LumiTrack — Backend (.env.example)
# Copie para .env e ajuste os valores. Este arquivo é versionado e NUNCA
# deve conter segredos reais — apenas placeholders.

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ─── Banco de dados (PostgreSQL) ─────────────────────────────────────────────
# Três bancos separados: app/dev, testes de service/unidade e testes de
# rotas HTTP (veja shared/test/prisma-test.ts e prisma-http-test.ts).
# ATENÇÃO: a suíte de testes APAGA os dados dos bancos de teste a cada
# execução — nunca aponte essas variáveis para um banco com dados reais.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lumitrack_dev?schema=public"
DATABASE_TEST_URL="postgresql://usuario:senha@localhost:5432/lumitrack_test?schema=public"
DATABASE_HTTP_TEST_URL="postgresql://usuario:senha@localhost:5432/lumitrack_test_http?schema=public"

# ─── Autenticação (JWT) ──────────────────────────────────────────────────────
# Gere um segredo aleatório (>= 32 caracteres), nunca reutilize este exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
JWT_WEB_EXPIRES_IN=1h
MOBILE_TOKEN_EXPIRES_IN=90d

# ─── Sessão via cookie (canal WEB) — ver #06 da remediação OWASP/LGPD ────────
# Cookie httpOnly com o JWT (sessão) + cookie legível com o token CSRF
# (double-submit). Nomes só precisam ser únicos no domínio da app — os
# defaults abaixo já funcionam sem alteração.
AUTH_COOKIE_NAME=lumitrack_session
CSRF_COOKIE_NAME=lumitrack_csrf
CSRF_HEADER_NAME=x-csrf-token

# ─── Criptografia de CPF/CNPJ (#07 da remediação OWASP/LGPD) ────────────────
# Duas chaves de 32 bytes (64 caracteres hex) — NUNCA reutilize a mesma chave
# para as duas variáveis (cifra e MAC exigem chaves independentes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_CNPJ_ENCRYPTION_KEY="troque-por-64-caracteres-hex-gerados-aleatoriamente-0000000000"
CPF_CNPJ_BLIND_INDEX_KEY="troque-por-outros-64-caracteres-hex-gerados-aleatoriamente-0000"

# ─── MFA opcional via TOTP (#12 da remediação OWASP/LGPD — A06/A07) ─────────
# Chave própria (32 bytes / 64 caracteres hex) — NUNCA reutilize a mesma chave
# de CPF_CNPJ_ENCRYPTION_KEY (compartimentaliza o risco entre categorias de
# dado). Gere com o mesmo comando do bloco acima.
MFA_SECRET_ENCRYPTION_KEY="troque-por-64-caracteres-hex-gerados-aleatoriamente-0000000000"

# ─── Criptografia do endereço da propriedade (#15 da remediação OWASP/LGPD) ──
# Chave própria (32 bytes / 64 caracteres hex) — endereço geográfico é
# categoria de dado pessoal distinta de CPF/CNPJ e de segredo MFA; nunca
# reutilize a mesma chave para categorias diferentes. Não há blind index:
# endereço não tem constraint @unique nem é usado como filtro de query.
# Gere com o mesmo comando dos blocos acima.
ADDRESS_ENCRYPTION_KEY="troque-por-64-caracteres-hex-gerados-aleatoriamente-0000000000"

# ─── Criptografia da credencial de protocolo do medidor (issue #182) ────────
# Chave própria (32 bytes / 64 caracteres hex) — protege Meter.extra.password
# (ex.: senha MQTT) em repouso; categoria de dado distinta das anteriores,
# nunca reutilize a mesma chave. Gere com o mesmo comando dos blocos acima.
METER_CREDENTIAL_ENCRYPTION_KEY="troque-por-64-caracteres-hex-gerados-aleatoriamente-0000000000"

# ─── Logger estruturado (#08 da remediação OWASP/LGPD) ──────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── E-mail (SMTP) — recuperação de senha ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM="LumiTrack <no-reply@lumitrack.local>"

# ─── CORS / Frontend ─────────────────────────────────────────────────────────
# NUNCA use "*" em produção (combinado com credentials: true na API,
# exporia a aplicação a qualquer origem — bloqueado por validação em
# config/env.ts quando NODE_ENV=production).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Host canônico do redirect HTTPS (issue #183) ────────────────────────────
# Usado SÓ em produção (NODE_ENV=production) para o redirect HTTP→HTTPS e
# para recusar (400) requisições com um Host diferente do domínio real —
# nunca eco do header Host do cliente (evita open redirect via Host
# forjado). Origin completo (com https://), sem barra final.
# Bloqueado por validação em config/env.ts se deixado no default de
# localhost com NODE_ENV=production.
PUBLIC_API_ORIGIN=http://localhost:3333

# ─── Rate limiting (opcional — há defaults no código) ────────────────────────
# Janela em milissegundos (900000 = 15 min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Retenção e expurgo de dados (#10 da remediação OWASP/LGPD — Art. 15/16) ─
# Dias de retenção após o dado ficar inativo (token expirado/revogado, reset
# usado/expirado, audit log antigo) antes do expurgo automático (opcional —
# há defaults no código).
DATA_RETENTION_AUTH_TOKEN_DAYS=30
DATA_RETENTION_PASSWORD_RESET_DAYS=30
DATA_RETENTION_AUDIT_LOG_DAYS=730

# ─── Refresh token da sessão WEB (#14 da remediação OWASP/LGPD — A06) ────────
# Canal WEB apenas — MOBILE usa token de 90 dias e não precisa de refresh.
# REFRESH_TOKEN_GRACE_PERIOD_MS: tolerância (ms) após rotação para aceitar o
# token antigo — evita falso positivo de reuso quando duas abas renovam
# quase simultaneamente (default 5000 = 5 s).
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_GRACE_PERIOD_MS=5000
REFRESH_COOKIE_NAME=lumitrack_refresh
REFRESH_CSRF_COOKIE_NAME=lumitrack_refresh_csrf
REFRESH_CSRF_HEADER_NAME=x-refresh-csrf-token
DATA_RETENTION_REFRESH_TOKEN_DAYS=30

# ─── Proteção SSRF nas conexões de saída do medidor (#10 da remediação ───────
# OWASP/LGPD — A01). Por padrão, loopback, link-local (inclusive
# 169.254.169.254 — metadata de cloud), RFC1918/ULA e multicast são negados
# antes de qualquer socket abrir. Esta variável é o único jeito de liberar o
# caso legítimo de medidor em rede local — sem ela, só destino público de
# fato alcançável na internet é aceito. Opcional; vazio = nenhuma exceção.
# Formato: hosts e/ou CIDRs separados por vírgula. Exemplo (NÃO copiar sem
# ajustar para a rede real do seu ambiente):
#   IOT_ALLOWED_HOSTS=broker.local,192.168.0.0/16,10.0.5.20/32
# No ambiente de demonstração da ADR-0008, o broker MQTT do iot-simulator
# roda na MESMA máquina com bind em 127.0.0.1 — logo o valor de produção é
# `IOT_ALLOWED_HOSTS=127.0.0.1/32` (ou `localhost`). Esse é exatamente o
# caso legítimo que a allowlist foi desenhada para permitir; não afrouxa a
# proteção, apenas nomeia o destino esperado.
IOT_ALLOWED_HOSTS=

# ─── Seed de demonstração — credenciais do broker do iot-simulator (#180) ────
# Lidas diretamente do processo do `npm run db:seed:demo` (não fazem parte do
# envSchema do backend) — populam extra.username/extra.password dos 4
# medidores MQTT de demo, para autenticar no broker embutido do simulador
# depois que ele passou a exigir credenciais. Opcionais: sem elas, o seed usa
# os mesmos valores de exemplo do .env.example do iot-simulator/server
# (sim-demo-user/sim-demo-pass) — só precisam bater com o BROKER_USERNAME/
# BROKER_PASSWORD reais do simulador que você for usar.
SIMULATOR_BROKER_USERNAME=
SIMULATOR_BROKER_PASSWORD=

# ─── Cadastro público (issue #177, ADR-0008) ─────────────────────────────────
# `false` fecha POST /api/users (403) — é a premissa da ADR-0008: o ambiente
# público só continua "sem transferência internacional" enquanto não tratar
# dado pessoal real. Junto disso, as 2 contas de demonstração (ver
# shared/config/demoAccounts.ts) ficam somente-leitura (e-mail/MFA) mesmo com
# o cadastro aberto. Default `true` — nenhum ambiente de desenvolvimento
# perde a função sem opt-in explícito; só o deploy da demo pública desliga.
REGISTRATION_ENABLED=true

# ─── Login de demonstração (issue #179, ADR-0008) ────────────────────────────
# `true` habilita POST /api/auth/demo-login — o frontend não embarca mais
# e-mail/senha das contas demo no bundle (achado MÉDIA do laudo de
# segurança); o cliente só escolhe o `profile` (residential/commercial) e o
# backend resolve a conta internamente, sem senha trafegar. Independente de
# REGISTRATION_ENABLED: o deploy público liga as duas, mas nada impede
# ligar só esta para testar o botão de demo sem fechar o cadastro. Default
# `false` — o endpoint responde 403 em qualquer ambiente sem opt-in.
DEMO_LOGIN_ENABLED=false

# ─── Topologia de produção (ADR-0008) ────────────────────────────────────────
# VM única na Oracle Cloud Always Free, região São Paulo, hospedando backend,
# frontend estático, PostgreSQL e o iot-simulator. Sem operador estrangeiro —
# é isso que mantém "nenhuma transferência internacional" verdadeiro depois
# do deploy (LGPD Art. 33-36). Ao publicar, ajuste:
#   DATABASE_URL         -> PostgreSQL local da própria VM (não exposto à
#                             internet), usuário lumitrack_app (deploy/create-app-role.sql,
#                             sem CREATE/DROP) — nunca o usuário administrativo
#                             de deploy/.env, que fica só para migração
#   CORS_ORIGIN           -> https://<domínio-canônico>   (nunca "*")
#   FRONTEND_URL          -> https://<domínio-canônico>   (compõe o link do e-mail)
#   PUBLIC_API_ORIGIN     -> https://<domínio-canônico>   (gate de go-live #5 — issue #183)
#   NODE_ENV              -> production
#   REGISTRATION_ENABLED  -> false   (gate de go-live #1 — ver abaixo)
#   DEMO_LOGIN_ENABLED    -> true    (mantém o botão de demo funcional sem cadastro aberto)
#   SMTP_*                -> nenhum provedor contratado; ficam em sandbox e o
#                             fluxo de "esqueci minha senha" NÃO é funcional na demo.
# Todas as chaves (JWT_SECRET e as cinco de criptografia) DEVEM ser
# regeradas para produção — nunca reaproveitar os valores deste arquivo.
# Gates de go-live (incluindo fechar o cadastro público, premissa da
# conformidade): ver .claude/docs/adr/0008-hospedagem-brasil-oracle-always-free.md
