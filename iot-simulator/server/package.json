{
    "name": "iot-simulator-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "aedes": "^1.1.1",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "mqtt": "^5.15.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.8.0",
        "globals": "^17.9.0",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.0.18"
    }
}
