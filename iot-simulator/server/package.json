{
    "name": "iot-simulator-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "depcruise": "depcruise src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "aedes": "^1.2.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.5",
        "helmet": "^8.3.0",
        "mqtt": "^5.16.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "dependency-cruiser": "^18.8.0",
        "eslint": "^10.15.0",
        "eslint-plugin-jsdoc": "^65.5.0",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "supertest": "^7.3.2",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
