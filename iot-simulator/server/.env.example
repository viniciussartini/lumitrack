NODE_ENV=development
BROKER_PORT=1883
BROKER_HOST=127.0.0.1
API_PORT=4100
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5180
LOG_LEVEL=info

# ─── Perímetro (issue #180) ───────────────────────────────────────────────────
# Ferramenta de desenvolvimento local — API_HOST/BROKER_HOST não devem sair de
# 127.0.0.1 fora de uma máquina de demonstração isolada. Valores abaixo são
# exemplos para rodar localmente — nunca reutilizar em produção.
# SIMULATOR_API_TOKEN protege /api/networks e /api/devices (header
# `Authorization: Bearer <token>`) — o mesmo valor deve estar em
# iot-simulator/ui/.env como VITE_SIMULATOR_API_TOKEN.
SIMULATOR_API_TOKEN=troque-por-um-token-aleatorio-de-pelo-menos-16-caracteres
# BROKER_USERNAME/BROKER_PASSWORD autenticam clientes MQTT no broker embutido
# (o próprio simulador e o backend real precisam das mesmas credenciais).
BROKER_USERNAME=sim-demo-user
BROKER_PASSWORD=sim-demo-pass
