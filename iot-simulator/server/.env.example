NODE_ENV=development
BROKER_PORT=1883
BROKER_HOST=127.0.0.1
API_PORT=4100
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5180
LOG_LEVEL=info

# ─── Perímetro (issue #180) ───────────────────────────────────────────────────
# Ferramenta de desenvolvimento local — API_HOST/BROKER_HOST não devem sair de
# 127.0.0.1 fora de uma máquina de demonstração isolada. Valores abaixo são
# exemplos para rodar localmente — nunca reutilizar em produção.
#
# ATENÇÃO — produção via docker-compose (ADR-0017): o simulador não
# compartilha mais a rede do `backend` (network_mode removido). Escutar em
# 127.0.0.1 dentro do próprio container o deixaria alcançável só por ele
# mesmo — nenhum outro container (incluindo o `backend`) chegaria nele. O
# `.env` de produção precisa sobrescrever para
# `BROKER_HOST=0.0.0.0`/`API_HOST=0.0.0.0` (escuta em todas as interfaces DO
# CONTAINER — ainda inacessível de fora, porque o compose não publica
# `ports:` para este serviço; só outros containers da mesma rede docker
# chegam nele). Manter `127.0.0.1` seria um "conectado, porém sem dado" já
# no primeiro deploy.
# SIMULATOR_API_TOKEN protege /api/networks e /api/devices (header
# `Authorization: Bearer <token>`) — o mesmo valor deve estar em
# iot-simulator/ui/.env como VITE_SIMULATOR_API_TOKEN.
SIMULATOR_API_TOKEN=troque-por-um-token-aleatorio-de-pelo-menos-16-caracteres
# BROKER_USERNAME/BROKER_PASSWORD autenticam clientes MQTT no broker embutido
# (o próprio simulador e o backend real precisam das mesmas credenciais).
BROKER_USERNAME=sim-demo-user
BROKER_PASSWORD=sim-demo-pass

# ─── Bootstrap da demo pública (ADR-0010) ────────────────────────────────────
# `true` cria no boot a rede "Demo" com os 4 devices que publicam nos mesmos
# tópicos dos medidores do seed de demonstração do backend
# (src/simulation/demoBootstrap.ts). Existe porque o store é em memória e o
# host gratuito da demo hiberna: sem isso, todo despertar deixaria o painel
# sem dado ao vivo. Em desenvolvimento deixe `false` e crie as redes pela UI
# — senão você ganha 4 devices que não pediu a cada `npm run dev`.
DEMO_BOOTSTRAP_ENABLED=false
