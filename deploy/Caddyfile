# Caddyfile — reverse proxy + TLS do go-live.
# {$DOMAIN} vem da variável de ambiente DOMAIN (deploy/.env, repassada pelo
# docker-compose.yml) — nunca hardcode o domínio real aqui.
#
# Caddy obtém e renova o certificado Let's Encrypt sozinho (HTTP-01/TLS-ALPN),
# sem certbot nem cron adicional — a porta 80 precisa estar acessível
# publicamente para o desafio ACME funcionar (já é o caso: ufw libera 80/443
# em deploy/provision-vm.sh).

{$DOMAIN} {
    # Compressão HTTP — cobre o bundle estático e, quando a resposta de
    # /api/* chega sem Content-Encoding do backend, também a API (o backend
    # já comprime por conta própria, ver app.ts; encode aqui é defesa em
    # profundidade e o que cobre o ambiente Render/staging, que não passa
    # pelo Caddy). Nunca duplica: Caddy não recomprime resposta que já
    # chegou com Content-Encoding. Exclui /api/iot/stream (SSE) pelo mesmo
    # motivo do filtro equivalente no Express (shouldCompress, ver
    # shared/middlewares/compressionFilter.ts): comprimir segura os chunks
    # no buffer até acumular um bloco, quebrando a entrega em tempo real.
    @nao_sse not path /api/iot/stream
    encode @nao_sse zstd gzip

    handle /api/* {
        reverse_proxy backend:3333
    }

    # Caminho com segmento oculto (/.env, /.git/config, /assets/.algo)
    # responde 404 em vez de cair no fallback da SPA com 200: nada disso
    # existe no build, e o 200 confunde varreduras de segurança. Exceção:
    # /.well-known/, reservado a padrões como security.txt e ACME.
    @oculto {
        path_regexp oculto /\.
        not path /.well-known/*
    }
    handle @oculto {
        respond 404
    }

    # Exposto de propósito para monitor externo de disponibilidade
    # (ADR-0015) — sem autenticação, sem dado pessoal no payload
    # (`{"status","timestamp"}`) e sem log de acesso (`app.ts` ignora
    # `/health` no pinoHttp). Reaproveita o raciocínio de conformidade da
    # ADR-0011: um ping não-autenticado aqui não configura transferência
    # internacional.
    handle /health {
        reverse_proxy backend:3333
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server

        # Cache longo e imutável para os assets com hash de conteúdo que o
        # Vite gera (ex.: index-C7g-RjOv.js) — seguro porque um conteúdo
        # novo sempre vem com um nome de arquivo novo, nunca reaproveita o
        # mesmo caminho. Sem isto, o navegador revalida (304) a cada
        # carregamento em vez de servir do cache local.
        @static path /assets/*
        header @static Cache-Control "public, max-age=31536000, immutable"
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Superconjunto da CSP via <meta> de frontend/index.html — cobre só
        # as 3 diretivas que uma <meta http-equiv="Content-Security-Policy">
        # não tem efeito nenhum ao entregar (frame-ancestors, base-uri,
        # object-src só valem via header HTTP; ver a nota técnica do gate #5
        # de go-live na ADR-0008). script-src/style-src/img-src/connect-src
        # continuam cobertos só pela <meta> — não duplicados aqui.
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # Cada cabeçalho com `?` fica na sua própria diretiva `header`: num mesmo
    # bloco, os campos com `?` viram uma condição conjunta e nenhum é aplicado
    # se qualquer um já existir. `?` só define quando a resposta ainda não traz
    # o cabeçalho: a API envia o próprio Referrer-Policy (helmet, no-referrer)
    # e ele vence, sem impedir o Permissions-Policy.
    header ?Referrer-Policy "strict-origin-when-cross-origin"
    # A aplicação não usa câmera, microfone, localização, pagamento nem
    # periféricos; a área de transferência continua liberada (códigos de MFA).
    header ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=()"
}
