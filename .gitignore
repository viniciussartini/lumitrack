# Dependências
node_modules/

# Build
dist/
*.tsbuildinfo

# Ambiente
.env
!.env.example

# Estado operacional do deploy/update-production.sh — SHA do último deploy
# bem-sucedido na VPS, nunca versionado.
deploy/.last-deployed-sha

# Saída do deploy/backup-postgres.sh (BACKUP_DIR default = <raiz do
# repo>/backups) — dumps criptografados do Postgres, nunca versionados. Sem
# esta regra, o `git status --porcelain` do update-production.sh sempre via
# esses arquivos como "não rastreados" e abortava o deploy por segurança
# (achado ao vivo na promoção da Fase 14-19, 2026-09-03).
backups/

# Nenhuma regra para backend/prisma/migrations/ aqui de propósito — as
# migrations DEVEM ser versionadas (histórico de schema é parte do código).
# Uma regra `prisma/migrations/` já existiu aqui, mas nunca casava de
# verdade (ancorada na raiz do repo, não em backend/) — inócua por acidente,
# não por intenção (#165).

# Testes
coverage/
playwright-report/
test-results/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Log de implementação (uso interno, não versionado)
.claude/docs/IMPLEMENTATION_LOG.md