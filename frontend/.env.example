VITE_API_BASE_URL=http://localhost:3000

# Opcional — caminho relativo "/api/iot/stream" é o default (mesma origem,
# dev/self-hosted). Só precisa de valor absoluto quando a API está em outra
# origem e o proxy na frente do site não sustenta conexão de longa duração
# (caso do rewrite de site estático do Render — ver render.yaml, ADR-0010).
# VITE_SSE_URL=http://localhost:3000/api/iot/stream

# Botões de "login de demonstração" na tela de login (ver
# .claude/docs/PLANO_SIMULADOR_IOT_E_SEED_DEMO.md, Fase 3) — só vira "true" no
# ambiente do deploy de demonstração pública, com o seed já rodado.
VITE_DEMO_MODE=false

# Canal de comunicação com o titular (LGPD Art. 18, issue #155) — publicado
# no rodapé da Landing, no shell autenticado e na Política de Privacidade.
# O valor abaixo é um PLACEHOLDER (este repositório é um projeto de
# portfólio, não uma operação real). Antes de qualquer uso comercial com
# titulares reais, troque por um endereço de fato monitorado — ver
# .claude/docs/PROCEDIMENTO_DIREITOS_TITULAR.md.
VITE_PRIVACY_CONTACT_EMAIL=privacidade@seu-dominio.com.br