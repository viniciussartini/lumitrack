{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:all": "concurrently --kill-others-on-fail -n backend,frontend -c blue,green \"cd ../backend && npm run dev\" \"npm run dev\"",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "depcruise": "depcruise src",
        "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json}\"",
        "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.7.1",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-slot": "^1.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.19.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.84.0",
        "react-markdown": "^10.1.0",
        "react-router": "^8.3.0",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.2.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.4",
        "dependency-cruiser": "^18.2.0",
        "eslint": "^10.8.0",
        "eslint-plugin-jsdoc": "^64.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.9.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.5"
    }
}
